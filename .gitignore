# Builds and scratch
/Bin/
Intermediate/
logs/
temp/
import/
__pycache__/
*.pyc

# The editor's data root is the repository root for an editor run from it: its own files there
# (the project list, settings, machine state, lock, update stage) are this machine's
/*.ini
/grizzly_editor.ltx
/machine.ltx
/editor.lock
/projects/
/update/
/.update/
_appdata_/

# The library and the game data beside the editor are local: a linked game or the author's own
# files. Only what the editor itself needs is tracked - the bundled quest catalog and PDA reader
# (the fallback when no game is linked), its own textures and its own library objects.
rawdata/backup/
rawdata/groups/
rawdata/levels/
rawdata/objects/
rawdata/particles/
rawdata/sounds/
rawdata/textures/
rawdata/*.dti
gamedata/*.*
gamedata/ai/
gamedata/anims/
gamedata/configs/*
!gamedata/configs/nq/
!gamedata/configs/pda/
!gamedata/configs/item_catalog.ltx
gamedata/levels/
gamedata/meshes/
gamedata/scripts/
gamedata/shaders/
gamedata/sounds/
gamedata/spawns/
gamedata/textures/

# A local documentation search index, not project content
/docs/index.bleve/

# The report hub's upload key the release build carries: never in the repository
crates/gz-feedback/report_token.local
