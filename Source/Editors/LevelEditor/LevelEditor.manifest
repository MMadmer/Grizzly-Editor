<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  XFined Editor runs with UTF-8 as its ANSI code page: every narrow Win32 and CRT
  call (FindFirstFileA, MoveFileA, fopen, ...) takes and returns UTF-8 - the text
  ImGui draws and MCP carries. A file name is therefore one string from the disk to
  the screen and back: a Cyrillic name no longer turns into cp1251 bytes that ImGui
  cannot draw, and a name typed in the editor no longer reaches the disk as UTF-8
  bytes read as cp1251. Windows 10 1903 or later; older systems ignore the setting.
  The game keeps cp1251: text it reads is converted explicitly, never via CP_ACP.
  DPI awareness is set in code (EditorStartup::DpiScale), not here.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
